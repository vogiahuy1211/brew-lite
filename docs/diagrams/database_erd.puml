@startuml
skinparam linetype ortho
skinparam roundcorner 5
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor White
  ArrowColor #444444
  BorderColor #555555
}

entity "Users" as Users {
  * id : uuid <<PK>>
  --
  * email : varchar(255) <<UK>>
  * password_hash : varchar(255)
  * role : enum('ADMIN', 'STAFF', 'CUSTOMER')
  loyalty_points : integer
}

entity "Products" as Products {
  * id : uuid <<PK>>
  --
  * name : varchar(255)
  * price : decimal(12,2)
  stock : integer
  version : integer
  image_url : text
}

entity "Toppings" as Toppings {
  * id : uuid <<PK>>
  --
  * name : varchar(255)
  * price : decimal(12,2)
}

entity "Ingredients" as Ingredients {
  * id : uuid <<PK>>
  --
  * name : varchar(255)
  * unit : varchar(50)
  stock_quantity : decimal(12,2)
  min_threshold : decimal(12,2)
  cost_per_unit : decimal(12,2)
}

entity "RecipeItems (BOM)" as RecipeItems {
  * id : uuid <<PK>>
  --
  * product_id : uuid <<FK>>
  * ingredient_id : uuid <<FK>>
  size : enum('S', 'M', 'L')
  topping_id : uuid <<FK>>
  * amount_needed : decimal(12,2)
}

entity "InventoryLogs" as InventoryLogs {
  * id : uuid <<PK>>
  --
  * ingredient_id : uuid <<FK>>
  order_id : uuid <<FK>>
  * change_quantity : decimal(12,2)
  balance_after : decimal(12,2)
  reason : varchar(255)
  created_at : timestamp
}

entity "Carts" as Carts {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK, UK>>
  created_at : timestamp
  updated_at : timestamp
}

entity "CartItems" as CartItems {
  * id : uuid <<PK>>
  --
  * cart_id : uuid <<FK>>
  * product_id : uuid <<FK>>
  * size : enum('S', 'M', 'L')
  * quantity : integer
  created_at : timestamp
}

entity "CartItemToppings" as CartItemToppings {
  * id : uuid <<PK>>
  --
  * cart_item_id : uuid <<FK>>
  * topping_id : uuid <<FK>>
}

entity "Promotions" as Promotions {
  * id : uuid <<PK>>
  --
  * code : varchar(50) <<UK>>
  * discount_amount : decimal(12,2)
  is_active : boolean
  start_at : timestamp
  end_at : timestamp
}

entity "Orders" as Orders {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  promo_id : uuid <<FK>>
  * status : enum('PENDING', 'PAID', 'PREPARING', 'READY', 'COMPLETED', 'PAYMENT_FAILED', 'CANCELLED')
  * subtotal : decimal(12,2)
  * discount_amount : decimal(12,2)
  * final_amount : decimal(12,2)
  created_at : timestamp
}

entity "OrderItems" as OrderItems {
  * id : uuid <<PK>>
  --
  * order_id : uuid <<FK>>
  * product_id : uuid <<FK>>
  * size : enum('S', 'M', 'L')
  * qty : integer
  * unit_price : decimal(12,2)
  * line_total : decimal(12,2)
}

entity "OrderItemToppings" as OrderItemToppings {
  * id : uuid <<PK>>
  --
  * order_item_id : uuid <<FK>>
  * topping_id : uuid <<FK>>
  price_at_purchase : decimal(12,2)
}

entity "Payments" as Payments {
  * id : uuid <<PK>>
  --
  * order_id : uuid <<FK>>
  * idempotency_key : varchar(100) <<UK>>
  * amount : decimal(12,2)
  * method : enum('VNPAY', 'WALLET', 'CARD')
  * status : enum('SUCCESS', 'FAILED', 'PENDING')
  created_at : timestamp
}

' Relationships
Users ||--o{ Orders : "places"
Users ||--o| Carts : "owns"

Carts ||--o{ CartItems : "contains"
CartItems }o--|| Products : "references"
CartItems ||--o{ CartItemToppings : "includes"
CartItemToppings }o--|| Toppings : "refers to"

Products ||--o{ RecipeItems : "has BOM"
Ingredients ||--o{ RecipeItems : "used in"
Ingredients ||--o{ InventoryLogs : "tracks"
Toppings ||--o{ RecipeItems : "recipes for"

Promotions ||--o{ Orders : "applies to"
Orders ||--o{ OrderItems : "has items"
Orders ||--o{ Payments : "paid via"
Orders ||--o{ InventoryLogs : "deducts"

OrderItems }o--|| Products : "ordered"
OrderItems ||--o{ OrderItemToppings : "has toppings"
OrderItemToppings }o--|| Toppings : "topping chosen"

@enduml
