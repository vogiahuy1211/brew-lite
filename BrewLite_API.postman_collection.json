        {
          "name": "Xác thực thanh toán VNPay Return (Giả lập Callback thành công)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var orderId = pm.collectionVariables.get(\"orderId\");",
                  "var secretKey = \"DDPPIYDOMWEKRTZNOSUCPWQNDSCILITC\";",
                  "var txnNo = Date.now().toString();",
                  "pm.collectionVariables.set(\"vnpTxnNo\", txnNo);",
                  "",
                  "function sortObject(obj) {",
                  "    var sorted = {};",
                  "    var keys = Object.keys(obj).sort();",
                  "    for (var i = 0; i < keys.length; i++) {",
                  "        var key = keys[i];",
                  "        if (obj[key] !== null && obj[key] !== undefined && obj[key] !== \"\") {",
                  "            sorted[key] = encodeURIComponent(String(obj[key])).replace(/%20/g, \"+\");",
                  "        }",
                  "    }",
                  "    return sorted;",
                  "}",
                  "",
                  "var params = {",
                  "    vnp_Amount: \"5000000\",",
                  "    vnp_BankCode: \"NCB\",",
                  "    vnp_CardType: \"ATM\",",
                  "    vnp_OrderInfo: \"Thanh toan don hang BrewLite\",",
                  "    vnp_PayDate: \"20261110090000\",",
                  "    vnp_ResponseCode: \"00\",",
                  "    vnp_TmnCode: \"5VKZAAJR\",",
                  "    vnp_TransactionNo: txnNo,",
                  "    vnp_TransactionStatus: \"00\",",
                  "    vnp_TxnRef: orderId",
                  "};",
                  "",
                  "var sorted = sortObject(params);",
                  "var signData = Object.keys(sorted).map(function(k) { return k + \"=\" + sorted[k]; }).join(\"&\");",
                  "var cryptoJs = require('crypto-js');",
                  "var hash = cryptoJs.HmacSHA512(signData, secretKey).toString(cryptoJs.enc.Hex);",
                  "pm.collectionVariables.set(\"vnpHash\", hash);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Xác thực giao dịch VNPay thành công (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.code).to.eql(\"00\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/vnpay/return?vnp_Amount=5000000&vnp_BankCode=NCB&vnp_CardType=ATM&vnp_OrderInfo=Thanh%20toan%20don%20hang%20BrewLite&vnp_PayDate=20261110090000&vnp_ResponseCode=00&vnp_TmnCode=5VKZAAJR&vnp_TransactionNo={{vnpTxnNo}}&vnp_TransactionStatus=00&vnp_TxnRef={{orderId}}&vnp_SecureHash={{vnpHash}}",
              "host": [
